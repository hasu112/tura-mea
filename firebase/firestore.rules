rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function semnat() { return request.auth != null; }
    function eu() { return request.auth.uid; }
    function md(e) { return /databases/$(database)/documents/echipe/$(e)/membri/$(request.auth.uid); }
    function proprietar() { return semnat() && exists(/databases/$(database)/documents/config/proprietar) && get(/databases/$(database)/documents/config/proprietar).data.uid == eu(); }
    function membru(e) { return semnat() && exists(md(e)) && get(md(e)).data.stare == 'activ'; }
    function admin(e) { return membru(e) && get(md(e)).data.rol == 'admin'; }
    function adminDupa(e) { return semnat() && existsAfter(md(e)) && getAfter(md(e)).data.rol == 'admin' && getAfter(md(e)).data.stare == 'activ'; }
    function schimba() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function nou() { return request.resource.data; }

    match /config/proprietar {
      allow get: if semnat();
      allow create: if semnat() && nou().uid == eu() && nou().keys().hasOnly(['uid', 'email', 'la']);
    }
    match /coduriCreare/{cod} {
      allow get: if semnat();
      allow list, create, delete: if proprietar();
      allow update: if semnat() && resource.data.folosit == null && schimba().hasOnly(['folosit']) && nou().folosit is string && getAfter(/databases/$(database)/documents/echipe/$(nou().folosit)).data.creatDe == eu() && getAfter(/databases/$(database)/documents/echipe/$(nou().folosit)).data.codCreare == cod;
    }
    match /utilizatori/{uid} {
      allow read: if semnat() && uid == eu();
      allow write: if semnat() && uid == eu() && nou().keys().hasOnly(['echipa']);
    }
    match /invitatii/{cod} {
      allow get: if semnat();
      allow create: if semnat() && nou().keys().hasOnly(['echipa']) && adminDupa(nou().echipa) && getAfter(/databases/$(database)/documents/echipe/$(nou().echipa)).data.cod == cod;
      allow delete: if admin(resource.data.echipa);
    }
    match /echipe/{e} {
      allow read: if membru(e);
      allow create: if semnat() && nou().creatDe == eu() && nou().keys().hasOnly(['nume', 'creatDe', 'creatLa', 'cod', 'codCreare']) && adminDupa(e) && (proprietar() || (nou().codCreare is string && get(/databases/$(database)/documents/coduriCreare/$(nou().codCreare)).data.folosit == null && getAfter(/databases/$(database)/documents/coduriCreare/$(nou().codCreare)).data.folosit == e));
      allow update: if admin(e) && schimba().hasOnly(['nume', 'cod']);
      match /dulap/{doc} {
        allow read, write: if membru(e);
      }
      match /membri/{uid} {
        allow read: if membru(e) || (semnat() && uid == eu());
        allow create: if semnat() && uid == eu() && nou().stare == 'activ' && ((nou().rol == 'membru' && nou().cod is string && get(/databases/$(database)/documents/invitatii/$(nou().cod)).data.echipa == e) || (nou().rol == 'admin' && !exists(/databases/$(database)/documents/echipe/$(e)) && getAfter(/databases/$(database)/documents/echipe/$(e)).data.creatDe == eu()));
        allow update: if (uid == eu() && membru(e) && !schimba().hasAny(['rol', 'stare', 'cod', 'intrat', 'email'])) || (admin(e) && uid != eu() && schimba().hasOnly(['rol', 'stare']) && nou().rol in ['admin', 'resp', 'membru'] && nou().stare in ['activ', 'scos']) || (admin(e) && uid == eu() && schimba().hasOnly(['rol']) && nou().rol in ['resp', 'membru']);
        allow delete: if uid == eu() && membru(e);
      }
    }
  }
}
